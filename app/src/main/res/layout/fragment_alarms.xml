<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground">

    <!-- 空状态提示 -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="还没有闹钟"
            android:textSize="18sp"
            android:textColor="?attr/appTextSecondary"
            android:layout_marginBottom="24dp" />

        <ImageButton
            android:id="@+id/btn_add_alarm_empty"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_circle_filled"
            android:src="@android:drawable/ic_input_add"
            android:tint="?attr/appOnAccent"
            android:tintMode="src_in"
            android:scaleType="center"
            android:padding="0dp"
            android:contentDescription="添加闹钟" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_alarms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        android:visibility="gone" />

    <!-- 始终显示的添加按钮（有闹钟时也在右下角） -->
    <ImageButton
        android:id="@+id/btn_add_alarm"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_filled"
        android:src="@android:drawable/ic_input_add"
        android:tint="?attr/appOnAccent"
        android:tintMode="src_in"
        android:scaleType="center"
        android:padding="0dp"
        android:contentDescription="添加闹钟"
        android:visibility="gone" />

</FrameLayout>
