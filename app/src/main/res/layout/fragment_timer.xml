<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.1" />

    <!-- 倒计时大显示（运行时显示） -->
    <TextView
        android:id="@+id/tv_timer_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textSize="48sp"
        android:textColor="@color/primary"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- HH:MM:SS 数字显示 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_hours"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="00"
            android:textSize="64sp"
            android:textColor="@color/on_background"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textSize="64sp"
            android:textColor="@color/primary"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_minutes"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="00"
            android:textSize="64sp"
            android:textColor="@color/on_background"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textSize="64sp"
            android:textColor="@color/primary"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_seconds"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="00"
            android:textSize="64sp"
            android:textColor="@color/on_background"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- 时/分/秒 标签 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="时" android:textSize="14sp" android:textColor="@color/gray_dark"
            android:gravity="center" />
        <View android:layout_width="24dp" android:layout_height="1dp" />
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="分" android:textSize="14sp" android:textColor="@color/gray_dark"
            android:gravity="center" />
        <View android:layout_width="24dp" android:layout_height="1dp" />
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="秒" android:textSize="14sp" android:textColor="@color/gray_dark"
            android:gravity="center" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.1" />

    <!-- 数字键盘 -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_1"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="1" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_2"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="2" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_3"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="3" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_4"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="4" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_5"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="5" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_6"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="6" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_7"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="7" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_8"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="8" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_9"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="9" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_timer_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="C" android:textSize="22sp" android:textColor="@color/wake_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_0"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="0" android:textSize="22sp" android:textColor="@color/on_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_timer_start"
            style="@style/Widget.Material3.Button"
            android:layout_width="72dp" android:layout_height="56dp"
            android:text="开始"
            android:textSize="18sp"
            app:cornerRadius="28dp" />
    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_timer_reset"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="180dp"
        android:layout_height="44dp"
        android:text="重置"
        android:textSize="16sp"
        app:strokeColor="@color/gray_light"
        android:layout_marginTop="12dp" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.1" />
</LinearLayout>
