<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#000000"
    android:padding="32dp">

    <!-- 顶部占位 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.25" />

    <!-- 闹钟标题 -->
    <TextView
        android:id="@+id/tv_alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="早上好"
        android:textSize="24sp"
        android:textColor="#A0A8C0"
        android:letterSpacing="0.05" />

    <!-- 闹钟时间 -->
    <TextView
        android:id="@+id/tv_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:00"
        android:textSize="80sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-thin" />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/tv_alarm_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="新的一天开始了"
        android:textSize="16sp"
        android:textColor="#8E8E9A"
        android:layout_marginTop="8dp" />

    <!-- 中间占位 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3" />

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <!-- 稍后提醒 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_snooze"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="稍后提醒"
            android:textSize="16sp"
            android:textColor="#A0A8C0"
            app:strokeColor="#3A3A5E"
            app:cornerRadius="28dp"
            android:layout_marginEnd="16dp" />

        <!-- 关闭闹钟 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="关闭"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp"
            app:backgroundTint="#FF5252"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>

    <!-- 滑动关闭区域 -->
    <FrameLayout
        android:id="@+id/slide_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp">

        <!-- 滑动轨道背景 -->
        <View
            android:id="@+id/slide_track_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_slide_track" />

        <!-- 滑动提示文字 -->
        <TextView
            android:id="@+id/tv_slide_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="滑动以关闭闹钟  →"
            android:textSize="16sp"
            android:textColor="#8E8E9A"
            android:alpha="0.8" />

        <!-- 滑动滑块 -->
        <View
            android:id="@+id/slide_thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_slide_thumb" />
    </FrameLayout>

    <!-- 查看每日播报 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_briefing_from_alarm"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="查看每日播报"
        android:textColor="#8E8E9A"
        android:visibility="gone" />

    <!-- 底部占位 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.15" />

</LinearLayout>
