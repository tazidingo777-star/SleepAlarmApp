<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/alarm_bg_start"
    android:padding="32dp">

    <!-- 顶部占位 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3" />

    <!-- 闹钟标题 -->
    <TextView
        android:id="@+id/tv_alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="早上好"
        android:textSize="22sp"
        android:textColor="#B0BEC5"
        android:letterSpacing="0.05" />

    <!-- 闹钟时间 -->
    <TextView
        android:id="@+id/tv_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:00"
        android:textSize="72sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-thin" />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/tv_alarm_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="新的一天开始了"
        android:textSize="16sp"
        android:textColor="#78909C"
        android:layout_marginTop="8dp" />

    <!-- 中间占位 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4" />

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 稍后提醒 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_snooze"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="稍后提醒"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:strokeColor="#546E7A"
            app:cornerRadius="28dp"
            android:layout_marginEnd="12dp" />

        <!-- 关闭闹钟 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="关闭"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>

    <!-- 查看每日播报 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_briefing_from_alarm"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="查看每日播报"
        android:textColor="#78909C"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- 底部占位 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.2" />

</LinearLayout>
