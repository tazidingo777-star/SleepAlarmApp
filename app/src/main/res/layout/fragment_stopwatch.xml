<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.15" />

    <!-- 秒表时间显示 -->
    <TextView
        android:id="@+id/tv_stopwatch_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00.00"
        android:textSize="64sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-thin"
        android:textStyle="bold" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.15" />

    <!-- 计次记录 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4">

        <TextView
            android:id="@+id/tv_laps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:gravity="center" />
    </ScrollView>

    <!-- 圆形按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stopwatch_reset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_stop_square"
            app:iconSize="28dp"
            app:iconGravity="textTop"
            app:cornerRadius="38dp"
            app:strokeColor="@color/gray_light"
            android:layout_marginEnd="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stopwatch_start"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_play_triangle"
            app:iconSize="32dp"
            app:iconGravity="textTop"
            app:cornerRadius="40dp"
            app:backgroundTint="@color/primary"
            style="@style/Widget.Material3.Button"
            android:layout_marginEnd="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stopwatch_lap"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_lap_flag"
            app:iconSize="28dp"
            app:iconGravity="textTop"
            app:cornerRadius="38dp"
            app:strokeColor="@color/gray_light" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.1" />
</LinearLayout>
