<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主应用主题 -->
    <style name="Theme.SleepAlarm" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">#EADDFF</item>
        <item name="colorOnPrimaryContainer">#21005D</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <!-- 闹钟响铃全屏主题 -->
    <style name="Theme.SleepAlarm.Alarm" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/alarm_bg_start</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
