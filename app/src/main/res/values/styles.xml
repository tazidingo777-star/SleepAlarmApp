<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 底部导航 -->
    <style name="BottomNavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- NumberPicker 分隔线颜色 -->
    <style name="NPTheme" parent="ThemeOverlay.Material3">
        <item name="colorControlNormal">#FF9500</item>
        <item name="colorControlActivated">#FF9500</item>
    </style>

    <!-- ===== iOS 设计系统 ===== -->

    <!-- 文字层级 -->
    <style name="TextTitle">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TextBody">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextCaption">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 卡片 -->
    <style name="CardStyle">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- 按钮 - 填充 -->
    <style name="ButtonFilled" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 按钮 - 描边 -->
    <style name="ButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
